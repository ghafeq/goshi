{
  "name": "@goshi/enterprise-nextjs",
  "version": "0.1.0",
  "description": "Next.js platform integration for Goshi Enterprise — ThemeProvider, useTheme, and the Icon component (wraps lucide-react).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@goshi/enterprise-tokens": "workspace:*",
    "@goshi/foundations-icons": "workspace:*"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "next": ">=14.0.0",
    "react": ">=18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "lucide-react": "^0.460.0",
    "next": "^15.0.3",
    "react": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
