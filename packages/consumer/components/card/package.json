{
  "name": "@goshi/consumer-components-card",
  "version": "0.1.0",
  "description": "Consumer (React Native) Card — informational card, translated from the Goshi Design System (Consumer) Figma file.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@goshi/consumer-components-shimmer": "workspace:*",
    "@goshi/consumer-react-native": "workspace:*",
    "@goshi/consumer-tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.73.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "react": "^18.3.1",
    "react-native": "^0.76.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
