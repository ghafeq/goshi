{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "tokens:build": {
      "inputs": ["src/**", "*.config.*js", "*.config.*ts"],
      "outputs": ["build/**", "dist/**", "src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "tokens:build"],
      "inputs": ["src/**", "package.json", "tsconfig.json"],
      "outputs": ["dist/**", "build/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
